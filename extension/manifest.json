{
  "manifest_version": 3,
  "name": "Personal Agents Drawer",
  "version": "0.2.0",
  "description": "Home page, agent tabs and an Omarchy-themed terminal cover for the Personal Agents Drawer. Site permissions are generated from agents.json by `agents-drawer build`.",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging",
    "favicon"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "agents.js",
        "keys.js",
        "cover.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "base.css",
        "sites/*.css"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
