#!/bin/bash
# agents-drawer: launcher for Personal Agents Drawer.
#
# Your agents' web apps (Claude Duet, Muse, ChatGPT Dots, ...)
# run as pre-rendered Chromium app windows in their own browser profile,
# stacked by Hyprland in the special:agents workspace, which slides in from
# the right edge over any workspace. Hyprland side:
# ~/.config/hypr/agents-drawer.lua.
#
#   agents-drawer toggle     show or hide the drawer
#   agents-drawer start      start the drawer browser (hidden) if it is not running
#   agents-drawer stop       quit the drawer browser
#   agents-drawer app <id>   open an agent as an app window in the drawer browser
#   agents-drawer build      apply the agent list (agents.json, plus your own
#                            ~/.config/agents-drawer/agents.json) and restart
#   agents-drawer theme      regenerate the theme from the current Omarchy theme
#   agents-drawer register   (re)write the native messaging host manifest
#
# AGENTS_DRAWER_DEBUG=1 agents-drawer start exposes DevTools on 127.0.0.1:9333
# for developing site themes. Leave it off otherwise: anything on this machine
# could then drive the signed-in drawer browser.

set -euo pipefail

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/agents-drawer"
PROFILE="$DATA/profile"
EXT="$DATA/extension"
HOST_NAME="io.github.caiomsantos95.agents_drawer"
USER_AGENTS="${XDG_CONFIG_HOME:-$HOME/.config}/agents-drawer/agents.json"
# Chromium refuses --app=chrome-extension://, so the drawer window opens on
# this placeholder and the extension swaps in its home page. The Wayland app
# id Chromium derives from it is how Hyprland recognizes the drawer.
HOME_URL="https://agents-drawer.invalid/"
CLASS="chrome-agents-drawer.invalid__-Default"
THEME_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"

# Unpacked extensions get an id derived from their absolute path.
ext_id() {
  python3 -c 'import hashlib,sys; h=hashlib.sha256(sys.argv[1].encode()).hexdigest()[:32]; print("".join(chr(ord("a")+int(c,16)) for c in h))' "$EXT"
}

running() { pgrep -f "[-]-user-data-dir=$PROFILE" >/dev/null; }

window_open() {
  hyprctl clients -j 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if any(c["class"]==sys.argv[1] for c in json.load(sys.stdin)) else 1)' "$CLASS"
}

notify() {
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send "$@"
  else
    notify-send "$@"
  fi
}

register() {
  mkdir -p "$PROFILE/NativeMessagingHosts"
  python3 - "$PROFILE/NativeMessagingHosts/$HOST_NAME.json" "$HOST_NAME" "$DATA/host.py" "$(ext_id)" <<'PY'
import json, sys
out, name, path, ext = sys.argv[1:5]
with open(out, "w") as f:
    json.dump({
        "name": name,
        "description": "Relays Personal Agents Drawer tab switches to Hyprland",
        "path": path,
        "type": "stdio",
        "allowed_origins": [f"chrome-extension://{ext}/"],
    }, f, indent=2)
PY
}

theme() {
  local font
  font=$(omarchy-font-current 2>/dev/null || echo "monospace")
  python3 - "$THEME_DIR/colors.toml" "$font" "$EXT/theme.css" <<'PY'
import colorsys, os, sys, tomllib

src, font, out = sys.argv[1:4]
try:
    with open(src, "rb") as f:
        c = tomllib.load(f)
except (OSError, tomllib.TOMLDecodeError):
    c = {}

def hx(v):
    v = v.lstrip("#")
    return tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))

def mix(a, b, t):
    a, b = hx(a), hx(b)
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(a, b))

bg = c.get("background", "#1a1b26")
fg = c.get("foreground", "#c0caf5")
dark = c.get("mode", "dark") != "light"
shade = "#000000" if dark else "#ffffff"
defaults = {
    "background": bg,
    "foreground": fg,
    "dark_background": mix(bg, shade, 0.2),
    "darker_background": mix(bg, shade, 0.4),
    "lighter_background": mix(bg, fg, 0.08),
    "dark_foreground": mix(fg, bg, 0.45),
    "light_foreground": mix(fg, bg, 0.15),
    "bright_foreground": fg,
    "accent": c.get("blue", "#7aa2f7"),
    "selection": mix(bg, fg, 0.2),
    "muted": mix(bg, fg, 0.3),
}
keys = list(defaults) + [
    "red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown",
    "bright_red", "bright_yellow", "bright_green", "bright_cyan", "bright_blue", "bright_magenta",
]
lines = []
for k in keys:
    v = c.get(k) or defaults.get(k)
    if not isinstance(v, str) or not v.startswith("#") or len(v) != 7:
        continue
    r, g, b = hx(v)
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    name = k.replace("_", "-")
    lines.append(f"  --om-{name}: {v};")
    lines.append(f"  --om-{name}-rgb: {r} {g} {b};")
    lines.append(f"  --om-{name}-hsl: {h * 360:.1f} {s * 100:.1f}% {l * 100:.1f}%;")

mode = "dark" if dark else "light"
font = font.replace('"', "")
css = (
    "/* Generated by `agents-drawer theme` from the current Omarchy theme. */\n"
    ":root {\n"
    f"  color-scheme: {mode};\n"
    f"  --om-mode: {mode};\n"
    f"  --om-font: \"{font}\", ui-monospace, monospace;\n"
    "  --om-header-h: 132px;\n"
    + "\n".join(lines)
    + "\n}\n"
)
with open(out + ".tmp", "w") as f:
    f.write(css)
os.replace(out + ".tmp", out)
PY
}

# Turn agents.json (shipped) plus the user's own agents.json into everything
# that depends on the agent list: the extension's list and site permissions,
# the Hyprland window rules (agents.lua) and the resolved list the native host
# and `app` read. User entries add agents or replace shipped ones by id;
# {"id": "...", "disabled": true} hides a shipped one.
build() {
  python3 - "$DATA/agents.json" "$USER_AGENTS" "$EXT" "$DATA" <<'PY'
import json, os, re, sys
from urllib.parse import urlsplit

shipped, user, ext, data = sys.argv[1:5]

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return []

agents = load(shipped)
for entry in load(user):
    agents = [a for a in agents if a.get("id") != entry.get("id")] + [entry]

URL = re.compile(r"https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~/-]*)?")
resolved = []
for a in agents:
    if a.get("disabled"):
        continue
    aid = a.get("id", "")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", aid) or aid == "home":
        sys.exit(f"agents.json: bad id {aid!r} (lowercase letters, digits and dashes)")
    if not URL.fullmatch(a.get("url", "")):
        sys.exit(f"agents.json: {aid}: url must be a plain https:// address")
    u = urlsplit(a["url"])
    hosts = a.get("hosts") or [u.hostname]
    if not all(re.fullmatch(r"[A-Za-z0-9.-]+", h) for h in hosts):
        sys.exit(f"agents.json: {aid}: bad host in hosts")
    theme = a.get("theme")
    if theme and not re.fullmatch(r"[a-z0-9-]+\.css", theme):
        sys.exit(f"agents.json: {aid}: theme must be a file name in browser/extension/sites/")
    resolved.append({
        "id": aid,
        "name": str(a.get("name", aid))[:40],
        "label": str(a.get("label", a.get("name", aid)))[:12],
        "url": a["url"],
        "hosts": hosts,
        "icon": a.get("icon") or f"https://{u.hostname}/favicon.ico",
        "css": f"sites/{theme}" if theme else None,
        # Chromium names an --app window's Wayland app id after its URL.
        "class": "chrome-" + u.hostname + "_" + (u.path or "/").replace("/", "_") + "-Default",
    })
if len(resolved) > 9:
    sys.exit("agents.json: at most 9 agents (Alt+1..9)")

def write(path, text):
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)

write(f"{data}/agents.resolved.json", json.dumps(resolved, indent=2))

public = [{k: a[k] for k in ("id", "name", "label", "url", "hosts", "icon", "css")} for a in resolved]
write(f"{ext}/agents.js",
      "// Generated by `agents-drawer build` from agents.json.\n"
      f"const CHATS = {json.dumps(public, indent=2)};\n\n"
      "function chatForHost(host) {\n  return CHATS.find((c) => c.hosts.includes(host));\n}\n")

lua = "-- Generated by `agents-drawer build` from agents.json.\nreturn {\n"
for a in resolved:
    lua += f'  {{ id = "{a["id"]}", class = "{a["class"]}" }},\n'
write(f"{data}/agents.lua", lua + "}\n")

with open(f"{ext}/manifest.json") as f:
    m = json.load(f)
patterns = sorted({f"https://{h}/*" for a in resolved for h in a["hosts"]})
m["host_permissions"] = patterns
m["content_scripts"][0]["matches"] = patterns
m["web_accessible_resources"][0]["matches"] = patterns
# Chromium keeps running an unpacked extension's old service worker until the
# version changes, so the last part is a hash of the extension's files.
import hashlib
digest = hashlib.sha256()
for root, _, files in sorted(os.walk(ext)):
    for name in sorted(files):
        if name in ("manifest.json", "theme.css"):
            continue
        with open(os.path.join(root, name), "rb") as f:
            digest.update(name.encode() + f.read())
base = ".".join(m["version"].split(".")[:3])
m["version"] = f"{base}.{int(digest.hexdigest()[:4], 16)}"
write(f"{ext}/manifest.json", json.dumps(m, indent=2) + "\n")
print("agents: " + ", ".join(a["id"] for a in resolved))
PY
}

# Start clean every time: no "restore pages?" bubble and no reopened windows.
reset_session() {
  local prefs="$PROFILE/Default/Preferences"
  rm -rf "$PROFILE/Default/Sessions"
  [[ -f $prefs ]] || return 0
  python3 - "$prefs" <<'PY'
import json, sys
p = sys.argv[1]
with open(p) as f:
    d = json.load(f)
d.setdefault("profile", {})["exit_type"] = "Normal"
d["profile"]["exited_cleanly"] = True
d.setdefault("session", {})["restore_on_startup"] = 5
with open(p, "w") as f:
    json.dump(d, f)
PY
}

# Chromium keeps an unpacked extension's old service worker registered across
# restarts, even when its files and version change. When the extension
# changed since the last start, drop the profile's service worker storage so
# the new one registers; the sites' own workers re-register on their own.
refresh_workers() {
  local version stamp="$DATA/.extension-version"
  version=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$EXT/manifest.json" 2>/dev/null) || return 0
  if [[ $(cat "$stamp" 2>/dev/null) != "$version" ]]; then
    rm -rf "$PROFILE/Default/Service Worker"
    printf '%s\n' "$version" >"$stamp"
  fi
}

launch() {
  if ! running; then
    reset_session
    refresh_workers
  fi
  local args=(
    --user-data-dir="$PROFILE"
    --app="$1"
    --load-extension="$EXT"
    --disable-extensions-except="$EXT"
    --no-first-run
    --no-default-browser-check
    --hide-crash-restore-bubble
  )
  if [[ ${AGENTS_DRAWER_DEBUG:-} == 1 ]]; then
    args+=(--remote-debugging-port=9333)
  fi
  setsid uwsm-app -- chromium "${args[@]}" >/dev/null 2>&1 &
}

case "${1:-toggle}" in
toggle)
  if ! hyprctl eval 'agents_drawer.toggle()' >/dev/null 2>&1; then
    notify "Personal Agents Drawer" "Not set up yet. Run install.sh from the plugin folder."
    exit 1
  fi
  ;;
start)
  if running && window_open; then exit 0; fi
  [[ -d $EXT ]] || { echo "agents-drawer: not installed (missing $EXT)" >&2; exit 1; }
  theme || true
  launch "$HOME_URL"
  ;;
app)
  url=$(python3 -c 'import json,sys; print(next(a["url"] for a in json.load(open(sys.argv[1])) if a["id"] == sys.argv[2]))' \
    "$DATA/agents.resolved.json" "${2:-}" 2>/dev/null) || {
    echo "agents-drawer: unknown agent: ${2:-}" >&2
    exit 1
  }
  launch "$url"
  ;;
build)
  build
  hyprctl reload >/dev/null 2>&1 || true
  if running; then
    "$0" stop
    "$0" start
  fi
  ;;
stop)
  pkill -f "[-]-user-data-dir=$PROFILE" || true
  for _ in $(seq 50); do running || break; sleep 0.1; done
  ;;
theme) theme ;;
register) register ;;
id) ext_id ;;
*)
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
  ;;
esac
